# Rust build output
/target
**/*.rs.bk
*.pdb

# Pipeline scratch space (written next to the output file)
.sr-scratch/
/scratch
/cache
/.sr-state
*.log

# Job database
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Generated test fixtures. `testdata/make_fixture.ps1` recreates all of them:
# they are megabytes of synthesised video, and the fixture attaches a copy of a
# system font that must not be redistributed.
/testdata/*
!/testdata/make_fixture.ps1

# Scratch directories used while investigating (never part of the tree).
/.sr-*/

# Downloaded model checkpoints: large, licensed by their authors, never redistributed.
/.sr-models/
/models/

# sr-native build output and the third-party binaries it links against.
# `third_party/ncnn` (45 MB of prebuilt libraries) and `vulkan-1.lib` are
# produced by native/sr-native/setup-third-party.ps1 from pins recorded in
# native/sr-native/pins.json; regenerating them is cheaper than versioning them.
/native/sr-native/build/
/native/sr-native/third_party/ncnn/
/native/sr-native/third_party/vulkan/